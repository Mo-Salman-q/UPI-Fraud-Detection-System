# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/

# ── Environment / secrets (NEVER commit) ─────────────────────────────────────
.env
.env.*

# ── Raw data (keep off Git; large + potentially licensed) ─────────────────────
data/raw/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── Editor / OS artefacts ─────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.DS_Store
Thumbs.db

# ── Test / coverage ───────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

